<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app. Avalonia also runs on macOS, which is how it's tested from the Mac. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Relay</AssemblyName>
    <RootNamespace>Relay.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Relay</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/relay.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- PDFium (Chrome's PDF engine) renders base64 PDFs in Preview. The macOS build is only for testing on the Mac. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8100" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="157.0.8100" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Relay.Core/Relay.Core.csproj" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
